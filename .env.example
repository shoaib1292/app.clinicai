# =============================================================================
# ClinicAI — Environment Configuration (v2)
# Copy this to .env and fill in your values. NEVER commit .env to git.
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql://clinicsai:changeme@localhost:5433/clinicsai
DB_USER=clinicsai
DB_PASSWORD=changeme
DB_NAME=clinicsai
DB_PORT=5433

# --- Auth & Security ---
# Generate via: node -e "require('crypto').randomBytes(48).toString('base64url')"
NEXTAUTH_URL=http://localhost:8000
NEXTAUTH_SECRET=replace-with-a-random-64-char-string
GATEWAY_API_KEY=sms-gateway-secret-change-me
JWT_SECRET=replace-with-a-random-64-char-string
JWT_REFRESH_SECRET=replace-with-another-random-64-char-string
# Must be 32+ bytes: node -e "require('crypto').randomBytes(32).toString('base64url')"
APP_ENCRYPTION_KEY=replace-with-a-32-char-minimum-key
SESSION_COOKIE=clinicsai_session

# --- Google OAuth (Cloud Console → APIs & Services → Credentials) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# --- Evolution API (QR-based WhatsApp) ---
EVOLUTION_API_URL=https://wa.yourdomain.com
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_WEBHOOK_URL=https://api.yourdomain.com/webhooks/evolution

# --- Meta Cloud API (Official WhatsApp Business) ---
META_WEBHOOK_VERIFY_TOKEN=clinicsai_verify
META_APP_SECRET=your-meta-app-secret


# --- In-Memory Store (Redis for production) ---
STORE_TYPE=memory
REDIS_URL=redis://:your-redis-password@localhost:6379
REDIS_PASSWORD=your-redis-password

# --- Notifications ---
# SMS via Twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM_NUMBER=+1234567890

# Email via Brevo REST API (POST /v3/smtp/email).
# Get API key from Brevo Dashboard → SMTP & API → API Keys (starts with xkeysib-).
# Also add your IP to Brevo Dashboard → Security → Authorised IPs.
BREVO_API_KEY=xkeysib-xxxxxxxx
BREVO_SENDER_EMAIL=noreply@clinicai.pk
BREVO_SENDER_NAME=ClinicAI

# --- Safe WhatsApp Reminder Sending (Evolution = unofficial, ban risk) ---
# Per-clinic daily cap for Evolution (QR/pairing) reminder sends. Above this,
# pending reminders wait for the next window instead of blasting (protects the
# Clinic's WhatsApp number from being limited by Meta). Cold numbers start at
# 50/day; raise ONLY after the number is 2+ weeks old & stable (warm-up rule).
EVOLUTION_DAILY_CAP=50
# Milliseconds to wait between consecutive Evolution reminder sends (human-like
# pacing, avoids burst detection). Default 3000 (3s).
REMINDER_SEND_DELAY_MS=3000
# Min gap (ms) between Evolution agent replies for the same clinic (per-patient
# pacing for live chat). Default 2500.
AGENT_REPLY_GAP_MS=2500
# Max Evolution agent replies to ONE patient per hour (stops runaway loops).
# Default 10.
EVO_PER_PATIENT_HOURLY_CAP=10
# Per-clinic cooldown (seconds) between emergency bulk emails. One operational
# email per clinic per window — prevents abuse. Default 86400 (24h).
EMERGENCY_EMAIL_COOLDOWN_SEC=86400

# --- Realtime (Socket.io) ---
REALTIME_PORT=3003

# --- Agent ---
AGENT_TEST_MODE=false

# --- Webhook Domain ---
# Used for Evolution API webhook URL (default: https://app.clinicai.pk)
WHATSAPP_WEBHOOK_BASE_URL=https://app.clinicai.pk
PUBLIC_BASE_URL=https://yourdomain.com
DOMAIN=yourdomain.com
APP_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
# Parent domain for clinic subdomains (slug.clinicai.pk style)
PARENT_DOMAIN=clinicai.pk

# --- Error Tracking (Sentry) ---
SENTRY_DSN=https://your-dsn.ingest.sentry.io
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=clinicai

# --- Slack Lead Notifications ---
SLACK_LEAD_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook

# --- Monitoring ---
UPTIME_KUMA_URL=https://uptime.yourdomain.com
LOKI_URL=http://loki:3100

# --- Storage ---
UPLOAD_DIR=./upload
MAX_UPLOAD_SIZE_MB=10
# Cloudflare R2 (clinic images, doctor photos, gallery). Zero egress cost.
# Get these from Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=clinicai-images
R2_PUBLIC_URL=https://cdn.clinicai.pk
# Cloudinary (legacy — payment screenshots only). Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- Payment Gateway (JazzCash) ---
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_SANDBOX=true

# --- Platform ---
PLATFORM_ADMIN_EMAIL=admin@clinicsai.com
PLATFORM_ADMIN_NAME=Platform Admin
PLATFORM_ADMIN_PASSWORD=replace-with-a-strong-admin-password
PLATFORM_DEFAULT_FEE=50
PLATFORM_CURRENCY=PKR

# --- LiveKit (self-hosted telemedicine) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_WEBHOOK_URL=http://localhost:8000/api/livekit/webhook

# --- Callrolin STT (Urdu/Hinglish speech-to-text) ---
CALLROLIN_STT_API_KEY=crstt-your-callrolin-stt-key

# --- Callrolin TTS (Urdu/Hinglish voice synthesis) ---
# Get API key from https://callrolin.com — Humnava-v2 model for native Urdu pronunciation
CALLROLIN_API_KEY=hmnv-your-callrolin-api-key
CALLROLIN_TTS_MODEL=humnava-v2

# =============================================================================
# Additional required variables (referenced in code, previously undocumented)
# =============================================================================

# --- Public URLs (client-visible, NEXT_PUBLIC_ prefix) ---
NEXT_PUBLIC_APP_URL=http://localhost:8000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
# Public base URL used to build patient booking links (no trailing slash)
PUBLIC_BOOKING_URL=http://localhost:8000

# --- Patient / Booking Auth ---
# 32+ byte random key for hashing patient phone numbers at rest
PHONE_HASH_SALT=replace-with-a-random-salt
# TOTP (magic-link / OTP) issuer name + allowed clock-skew window (steps)
TOTP_ISSUER=ClinicAI
TOTP_WINDOW=1
# Short-lived JWTs for the patient portal (seconds). Generate a 64-char secret.
PATIENT_JWT_SECRET=replace-with-a-random-64-char-string
# Signed token for anonymous booking links (generate a 64-char secret).
BOOKING_TOKEN_SECRET=replace-with-a-random-64-char-string

# --- CORS ---
# Comma-separated origins allowed to call the API (dashboard + landing domains)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- JWT lifetimes (clinic staff sessions, seconds) ---
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# --- LLM / AI ---
OPENAI_API_KEY=sk-your-openai-key
# Vision model used for lab/payment slip OCR (e.g. gpt-4o-mini)
VLM_MODEL=gpt-4o-mini
# AssemblyAI key for Urdu/Hinglish speech-to-text
ASSEMBLYAI_API_KEY=your-assemblyai-key

# --- Outbound Email via SMTP (alternative to Brevo REST) ---
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=noreply@clinicai.pk

# --- SMS provider selection ---
# One of: twilio | brevo | null
SMS_PROVIDER=twilio

# --- Message pacing & debounce (anti-ban, human-like timing) ---
# Delay (ms) per word when streaming long WhatsApp replies
PACING_WORD_DELAY_MS=45
# Min / max total delay (ms) added to a reply
PACING_MIN_DELAY_MS=400
PACING_MAX_DELAY_MS=1800
# Extra delay (ms) before triage/booking replies
PACING_TRIAGE_DELAY_MS=600
# Window (ms) to coalesce rapid inbound messages into one reply
DEBOUNCE_WINDOW_MS=1200

# --- Patient reactivation ---
# Days of inactivity before a patient is considered dormant for re-engagement
DORMANT_THRESHOLD_DAYS=45

# --- Low-balance alerts ---
# Notify when clinic credit balance drops below this % of a top-up threshold
LOW_BALANCE_THRESHOLD_PCT=15
# Webhook fired when a clinic hits the low-balance threshold
LOW_BALANCE_WEBHOOK_URL=https://hooks.slack.com/services/your-webhook

# --- Branding ---
# Absolute URL of the ClinicAI logo (used in email/notification templates)
LOGO_URL=https://app.clinicai.pk/logo-light.png
