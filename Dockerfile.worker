# ── Stage 1: Install dependencies ──
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Copy package manifests
COPY package.json package-lock.json ./
COPY prisma ./prisma/

# Install ALL dependencies (worker imports src/lib which needs full deps)
RUN npm ci --legacy-peer-deps

# Generate Prisma client
RUN npx prisma generate

# Copy worker source
COPY tsconfig.json ./
COPY worker/ ./worker/
COPY src/ ./src/

# ── Stage 2: Production runtime ──
FROM node:22-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Install curl + ca-certificates + passwd
RUN apt-get update -qq && \
    apt-get install -qq --no-install-recommends curl ca-certificates passwd && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd --gid 1001 nodejs && \
    useradd --uid 1001 --gid 1001 --no-create-home --shell /bin/sh nextjs

# Copy dependencies + Prisma client
COPY --from=builder --chown=nextjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma

# Copy worker code
COPY --from=builder --chown=nextjs:nodejs /app/worker ./worker
COPY --from=builder --chown=nextjs:nodejs /app/src ./src

# Copy tsconfig for tsx runtime resolution
COPY --from=builder --chown=nextjs:nodejs /app/tsconfig.json ./tsconfig.json

USER nextjs

# Run the worker index
CMD ["node", "--import", "tsx", "worker/index.ts"]
